# Kopie als .env.local anlegen und Werte einsetzen.

# Oeffentlich, landen im Client-Bundle - das ist so vorgesehen.
NEXT_PUBLIC_SUPABASE_URL=https://to-replace-by-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=to-replace-by-key

# GEHEIM. Umgeht RLS vollstaendig, wird nur serverseitig gelesen.
# Kein NEXT_PUBLIC_-Praefix: das wuerde den Key in jedes Bundle inlinen.
SUPABASE_SERVICE_ROLE_KEY=to-replace-by-service-role-key
