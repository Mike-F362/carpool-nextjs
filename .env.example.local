# Copy to .env.local and fill in the values.

# Public, ends up in the client bundle - that is intended.
NEXT_PUBLIC_SUPABASE_URL=https://to-replace-by-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=to-replace-by-key

# SECRET. Bypasses RLS entirely, read on the server only.
# No NEXT_PUBLIC_ prefix: that would inline the key into every bundle.
SUPABASE_SERVICE_ROLE_KEY=to-replace-by-service-role-key

# SECRET, and not used by the app - only by scripts/dump_db.sh|.cmd, which read
# this one key out of .env.local. Direct Postgres connection, so this is the
# database password from project creation, not one of the keys above.
# Dashboard -> Connect -> Session pooler (URI, port 5432); the transaction
# pooler on 6543 cannot serve pg_dump. Percent-encode special characters in the
# password (@ -> %40, # -> %23, / -> %2F) or the URL parses at the wrong place.
SUPABASE_DB_URL=postgresql://postgres.to-replace-by-ref:to-replace-by-password@aws-0-to-replace-by-region.pooler.supabase.com:5432/postgres

# LOCAL TEST STACK ONLY. scripts/create_test_admin.mjs recreates this account
# after `supabase db reset`, which drops auth.users along with everything else.
# The script refuses to run unless NEXT_PUBLIC_SUPABASE_URL is a loopback
# address, so these two are never used against the hosted project.
# Minimum password length is 6, set in supabase/config.toml.
TEST_ADMIN_EMAIL=admin@localhost
TEST_ADMIN_PASSWORD=to-replace-by-a-local-only-password
